# StorageHub Production Environment Configuration
# Copy this to .env.production and edit with your settings
#
# Only the variables below are read by docker-compose.yml. Backup provider
# credentials (Google Drive, Dropbox) and SSL/Let's Encrypt settings are
# configured in the app (Admin panel) and stored in the database — they do
# not belong in this file.

# ===========================================
# REQUIRED SETTINGS
# ===========================================
# Compose refuses to start without these (${VAR:?} interpolation).

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=

# PostgreSQL password (used by both the postgres container and the backend's
# database connection). Pick a strong, unique password.
POSTGRES_PASSWORD=

# ===========================================
# AI FEATURES (Optional but recommended)
# ===========================================

# AI Provider: "openai" for real classification, "mock" for testing
AI_PROVIDER=openai

# OpenAI API key for image classification and summaries
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# DEPLOYMENT
# ===========================================

# Public URL where users reach the app (via nginx, port 80/443).
# Used for QR codes, share links, and as the primary CORS origin.
FRONTEND_URL=https://192.168.200.13

# Additional CORS origins, comma-separated — set this if the app is reachable
# at more than one URL (e.g. LAN IP plus a domain name).
# Example: CORS_ORIGINS=http://192.168.1.10,https://storagehub.example.com
CORS_ORIGINS=

# ===========================================
# DATABASE (defaults are fine for Docker)
# ===========================================

POSTGRES_USER=storagehub
POSTGRES_DB=storagehub

# ===========================================
# UPLOADS
# ===========================================

# Maximum upload size for item/container photos, in megabytes
MAX_UPLOAD_SIZE_MB=10
