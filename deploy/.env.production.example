# StorageHub Production Environment Configuration
# Copy this to .env.production and edit with your settings

# ===========================================
# REQUIRED SETTINGS
# ===========================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_32_chars

# Database (uses Docker internal networking)
DATABASE_URL=postgresql://storagehub:storagehub_secret@postgres:5432/storagehub

# Redis (uses Docker internal networking)
REDIS_URL=redis://redis:6379/0

# ===========================================
# AI FEATURES (Optional but recommended)
# ===========================================

# OpenAI API key for image classification and summaries
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# FILE STORAGE
# ===========================================

# Upload directory (inside container)
UPLOAD_DIR=/app/uploads

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# Application URL (for generating QR codes and share links)
APP_URL=http://192.168.200.13:3000

# API URL (if different from APP_URL)
API_URL=http://192.168.200.13:8000

# Debug mode (set to false in production)
DEBUG=false

# Log level
LOG_LEVEL=INFO

# ===========================================
# BACKUP PROVIDERS (Optional)
# ===========================================

# Google Drive - paste full service account JSON (single line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Dropbox access token
# DROPBOX_ACCESS_TOKEN=

# ===========================================
# SSL/HTTPS (Optional - for public access)
# ===========================================

# Domain name (if using HTTPS)
# DOMAIN=storagehub.example.com

# Let's Encrypt email
# LETSENCRYPT_EMAIL=admin@example.com
