# Docker Environment Configuration
# Copy this to .env and modify as needed

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=change-me-in-production-min-32-chars-long

# AI Provider
# Options: openai, mock
AI_PROVIDER=mock

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Note: Database and Redis URLs are configured in docker-compose.yml
# and don't need to be set here unless you're using external services
