# StorageHub Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# LOCAL DEVELOPMENT (without Docker)
# =============================================================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/storagehub

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secure-secret-key-min-32-chars

# AI Provider (openai or mock)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Alternative: Google Cloud Vision
# AI_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend URL (for QR codes)
FRONTEND_URL=http://localhost:5173

# Printer Defaults
DEFAULT_LABEL_WIDTH_MM=51
DEFAULT_LABEL_HEIGHT_MM=25

# =============================================================================
# DOCKER (use docker-compose.yml)
# =============================================================================
# When using Docker, only these variables need to be set:
#   SECRET_KEY - Change this to a secure random string
#   AI_PROVIDER - Set to 'openai' or 'mock'
#   OPENAI_API_KEY - Required if AI_PROVIDER=openai
#
# Database and Redis are configured automatically in docker-compose.yml
# See .env.docker for a minimal Docker configuration
