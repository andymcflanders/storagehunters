# Database
DATABASE_URL=postgresql://user:password@localhost:5432/storagehub

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secure-secret-key-min-32-chars

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Alternative: Google Cloud Vision
# AI_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend URL (for QR codes)
FRONTEND_URL=http://localhost:5173

# Printer Defaults
DEFAULT_LABEL_WIDTH_MM=51
DEFAULT_LABEL_HEIGHT_MM=25
