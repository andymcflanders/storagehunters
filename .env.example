# StorageHub Environment Configuration
#
# Copy this file to .env and edit the values:
#   cp .env.example .env
#
# Required values are marked REQUIRED. Everything else has a sensible default.

# =============================================================================
# REQUIRED
# =============================================================================

# Secret key for session/JWT tokens.
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# PostgreSQL password (used by both the postgres container and the backend's
# DATABASE_URL).
POSTGRES_PASSWORD=

# =============================================================================
# AI FEATURES (optional but recommended)
# =============================================================================

# AI provider: "openai" for real classification, "mock" for offline/testing.
AI_PROVIDER=mock

# OpenAI API key — required if AI_PROVIDER=openai.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# DEPLOYMENT
# =============================================================================

# Public URL where the frontend is reachable. Used to generate QR codes,
# share links, and as the primary CORS origin. Change this when you deploy
# behind a real domain.
FRONTEND_URL=http://localhost

# Additional CORS origins, comma-separated. Use this when the app is reachable
# at multiple URLs (e.g. LAN IP + domain name). Localhost variants are always
# allowed.
# Example: CORS_ORIGINS=http://192.168.1.10,https://storagehub.example.com
CORS_ORIGINS=

# =============================================================================
# DATABASE / POSTGRES (defaults are fine for Docker)
# =============================================================================

POSTGRES_USER=storagehub
POSTGRES_DB=storagehub

# =============================================================================
# UPLOADS
# =============================================================================

MAX_UPLOAD_SIZE_MB=10
