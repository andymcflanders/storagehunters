			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Scan QR Code",
			"short_name": "Scan",
			"description": "Scan a container QR code",
			"url": "/scan",
			"icons": [{ "src": "/icons/scan-96.png", "sizes": "96x96" }]
		},
		{
			"name": "Search Items",
			"short_name": "Search",
			"description": "Search your stored items",
			"url": "/search",
			"icons": [{ "src": "/icons/search-96.png", "sizes": "96x96" }]
		}
	],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "images",
					"accept": ["image/*"]
				}
			]
		}
	}
}
